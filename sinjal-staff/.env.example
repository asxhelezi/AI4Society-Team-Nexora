# The staff app uses the real backend by default. The Vite dev server proxies /v1 to localhost:8080.
VITE_STAFF_REAL=true
VITE_STAFF_API_URL=

# Supabase (no application server). When both are set the staff app, its login page and
# live updates use Supabase instead of /v1. The publishable key is safe in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
