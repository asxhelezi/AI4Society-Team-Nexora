# The staff app uses the real backend by default. The Vite dev server proxies /v1 to localhost:8080.
VITE_STAFF_REAL=true
VITE_STAFF_API_URL=

# Set both to read the staff tables from Supabase instead of the /v1 API (see STAFF_BACKEND.md).
# The publishable key is meant to be public; RLS (supabase/staff-access.sql) protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
