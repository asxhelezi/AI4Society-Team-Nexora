APP_ENV=production
APP_TIMEZONE=Europe/Tirane

POSTGRES_DB=sinjal
POSTGRES_USER=sinjal
POSTGRES_PASSWORD=replace-with-a-random-hex-password
REDIS_PASSWORD=replace-with-a-different-random-hex-password
DATABASE_URL=postgresql+asyncpg://sinjal:replace-with-a-random-hex-password@postgres:5432/sinjal
REDIS_URL=redis://:replace-with-a-different-random-hex-password@redis:6379/0

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_HOURS=8
CORS_ORIGINS=https://your-citizen-domain.example,https://your-staff-domain.example
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
UPLOAD_MAX_PIXELS=25000000
PUBLIC_MAP_MAX_RESULTS=500
IDEMPOTENCY_TTL_HOURS=48
# Optional: south,west,north,east. Leave empty until the municipality confirms its boundary.
SERVICE_AREA_BOUNDS=

BOOTSTRAP_ADMIN_EMAIL=ai4societyalbania@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ADMIN_NAME=SINJAL Administrator
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

TURNSTILE_SITE_KEY=replace-with-cloudflare-site-key
TURNSTILE_SECRET=replace-with-cloudflare-secret-key
TURNSTILE_HOSTNAMES=your-citizen-domain.example
TURNSTILE_ACTION=submit_report

PUBLIC_API_BASE_URL=https://your-api-domain.example

# Optional generic JSON AI endpoint. No Claude/OpenAI key is required by default.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

MAP_PROVIDER_URL=https://nominatim.openstreetmap.org
MAP_TILE_PROVIDER_URL=https://tile.openstreetmap.org
MAP_USER_AGENT=SINJAL/2.0 (contact: ai4societyalbania@gmail.com)
MAP_CONTACT_EMAIL=ai4societyalbania@gmail.com
MAP_COUNTRY_CODES=al
MAP_CACHE_TTL_SECONDS=604800


AI_API_KEY=
AI_BASE_URL=https://llm.mjovanovic.dev/v1
AI_MODEL=gpt-5-mini
# 1 = pa thirrje reale, $0 (zhvillim/teste). 0 = AI real.
AI_MOCK=1
AI_DUPLICATE_THRESHOLD=0.57
# Veprimet automatike (0 = AI vetem sugjeron)
AI_AUTO_ACTIONS=1
AI_AUTO_ACCEPT_CONFIDENCE=90
AI_AUTO_REJECT_SPAM_CONFIDENCE=95
AI_AUTO_DUPLICATE_SIMILARITY=0.70