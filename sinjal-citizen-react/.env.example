# Copy to .env.local and adjust. Vite only exposes variables prefixed with VITE_.

# Base URL of the Sinjal FastAPI backend (no trailing slash). Requests go to
# `${VITE_API_URL}/v1/...`. Leave empty to call the same origin (e.g. behind a proxy).
VITE_API_URL=http://localhost:8000

# Mocks are ON unless this is exactly "false". The mocks reproduce the static
# site's demo data (tracking results, map pins, generated tracking codes), so the
# app works with no backend running. Set to false to talk to the real API.
VITE_USE_MOCKS=true
